# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are embedded in the
# app bundle and are visible to anyone with the app — NEVER put secrets here.

# Base URL of the Koode API (Cloudflare Worker).
#   iOS Simulator:   http://localhost:8787
#   Physical device: http://<your-mac-LAN-IP>:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
