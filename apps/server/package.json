{
  "name": "@koode/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:new": "wrangler d1 migrations create DB",
    "invite:create": "node scripts/create-invite.mjs"
  },
  "dependencies": {
    "@koode/shared": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@livekit/rtc-node": "1.1.0",
    "@signalapp/libsignal-client": "0.103.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
